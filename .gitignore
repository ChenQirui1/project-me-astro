# build output
dist/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables — never commit any of them. The glob catches strays
# like .env.local and timestamped .env.bak-* backups, which the old two-line
# rule let through; .env.example is the committed template.
.env*
!.env.example

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# wrangler local state
.wrangler/

# Confluence is the source of truth for project content. The sync runs inside
# the Cloudflare build and writes into the build container only, so none of
# this is ever committed. See astro/scripts/sync-confluence.mjs.
astro/src/content/projects/*.md
astro/assets/confluence/

# Superseded: the asset manifest now lives in R2 so local runs and the build
# container share one copy. See astro/scripts/assets.mjs.
astro/assets/.manifest.json

# Rewrites staged for pasting into Confluence, not for the site. Confluence is
# the gate for what becomes public and this repo is not, so the drafts — which
# name clients and carry the notes on what was cut — stay local.
drafts/
