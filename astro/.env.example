# Copy to astro/.env and fill in. Every .env* file is gitignored.
#
# In CI these are Workers Builds *build* variables, set under the Worker's
# Settings > Build > Variables and secrets. Build variables are a separate
# namespace from runtime secrets: the sync runs at build time, so the tokens
# below are never bound into the deployed Worker.

# --- Confluence -------------------------------------------------------------
# Site base URL, including the /wiki context path.
CONFLUENCE_BASE_URL=https://ivanchencode.atlassian.net/wiki

# The Atlassian account the API token belongs to.
CONFLUENCE_EMAIL=ivanchen.code@gmail.com

# Create at: https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_API_TOKEN=

# The portfolio root page — only pages beneath it are considered as projects.
# Either the page id or its exact title. Required.
CONFLUENCE_ROOT=1769690

# Publication gate: the Confluence page status that publishes a project.
# A custom content state — add it in Space settings > Content states.
# Optional, default: Ready for Publish
CONFLUENCE_PUBLISH_STATUS=Ready for Publish

# Optional — restrict the sync to a single space key.
CONFLUENCE_SPACE_KEY=P

# --- Cloudflare -------------------------------------------------------------
# Needed for non-interactive runs (CI), where scripts/assets.mjs reads and
# writes both the R2 objects and the .manifest.json bookkeeping key.
# Locally `wrangler login` is enough.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional — overrides the bucket name used by scripts/assets.mjs.
R2_BUCKET=project-me-assets
