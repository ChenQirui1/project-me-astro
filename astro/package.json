{
  "name": "project-me-astro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "preview:cf": "astro build && wrangler dev",
    "astro": "astro",
    "test": "node --test \"scripts/*.test.mjs\"",
    "assets:push": "node scripts/assets.mjs push",
    "assets:pull": "node scripts/assets.mjs pull",
    "sync:confluence": "node scripts/sync-confluence.mjs",
