    "@types/react-dom": "^19.2.3",
    "astro": "^5.18.0",
    "masonry-layout": "^4.2.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-is": "^19.2.4",
    "sass": "^1.83.0",
    "styled-components": "^6.3.11",
    "tailwindcss": "^4.1.14",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260812.1",
    "@types/masonry-layout": "^4.2.8",
