---
import { getCollection } from "astro:content";
import { asset } from "../lib/assets";

const galleryItems = await getCollection("gallery");
const sortedItems = galleryItems.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

// Map aspect ratio to Tailwind class
const aspectRatioClass = (ratio: string) => {
  switch (ratio) {
    case '3x4': return 'aspect-[3/4]';
    case '4x3': return 'aspect-[4/3]';
    case '1x1': return 'aspect-square';
    case '16x9': return 'aspect-video';
    default: return 'aspect-[4/3]';
  }
};

// Columns are sized so n tiles plus (n-1) gutters fill the row exactly, with the
// gutter fixed at the same 1rem as the vertical gap (`mb-4`) between tiles.
const columnWidth =
  "w-[calc((100%_-_1rem)/2)] md:w-[calc((100%_-_2rem)/3)] lg:w-[calc((100%_-_3rem)/4)] xl:w-[calc((100%_-_4rem)/5)]";
---

<div class="gallery-grid after:content-[''] after:block after:clear-both">
  <div class="gutter-sizer w-4"></div>
  <div class={`grid-sizer float-left ${columnWidth}`}></div>
  {
    sortedItems.map((item) => (
      <div
        class={`grid-item float-left mb-4 ${columnWidth} ${aspectRatioClass(item.data.aspectRatio)}`}
      >
        <a id={item.id} href={`/gallery/${item.id}`} class="group block h-full w-full scroll-mt-10">
          {/* Contact-sheet frame: hairline on paper, no shadow, no lift. */}
          <div class="relative h-full w-full overflow-hidden border border-ink bg-paper-pure">
            <img
              src={asset(item.data.image)}
              alt={item.data.title}
              class="h-full w-full object-cover"
              loading="lazy"
            />
            {/* Caption plate. Flat ink, snapped in at 80ms — never faded. */}
            <div class="absolute inset-x-0 bottom-0 flex items-center gap-1.5 bg-ink px-2 py-1 opacity-0 transition-opacity duration-[80ms] ease-linear group-hover:opacity-100">
              <span class="h-[6px] w-[6px] shrink-0 bg-warning" aria-hidden="true" />
              <span class="label truncate text-paper-pure">{item.data.caption}</span>
            </div>
          </div>
        </a>
      </div>
    ))
  }
</div>

<script>
  import Masonry from "masonry-layout";

  function initMasonry() {
    const grid = document.querySelector(".gallery-grid");
    if (!grid) return;

    // Every tile carries a fixed aspect ratio, so its height is known before
    // its image arrives — lay out straight away. (Waiting for the images used
    // to stall forever: lazy images below the fold never load until scrolled
    // to, so the tiles were left as plain floats with no gutters.)
    const msnry = new Masonry(grid, {
      gutter: ".gutter-sizer",
      columnWidth: ".grid-sizer",
      itemSelector: ".grid-item",
      percentPosition: true,
      transitionDuration: 0,
    });

    // Masonry moves every item, so the browser's jump to a #item from a
    // detail page's back link lands on the old position. Re-find it once the
    // layout has settled.
    msnry.once("layoutComplete", () => {
      const target =
        location.hash && document.getElementById(location.hash.slice(1));
      target?.scrollIntoView({ block: "center" });
    });
    msnry.layout();
  }

  // Fires on the first load too, under the view-transitions router.
  document.addEventListener("astro:page-load", initMasonry);
</script>
