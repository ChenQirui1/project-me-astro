---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { asset } from "../../lib/assets";

export async function getStaticPaths() {
  const galleryItems = await getCollection("gallery");
  return galleryItems.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

type Props = {
  item: CollectionEntry<"gallery">;
};

const { item } = Astro.props;
const { Content } = await render(item);
---

<Layout title={item.data.title}>
  <article class="mx-auto w-full max-w-[1000px] p-4 sm:p-8">
    <div class="mb-8">
      <a href={`/gallery#${item.id}`} class="btn btn-ghost">← back to gallery</a>
    </div>

    <div class="mb-6 border border-ink bg-paper-pure p-2">
      <img
        src={asset(item.data.image)}
        alt={item.data.title}
        class="mx-auto block w-full border border-ink"
      />
    </div>

    <div class="mx-auto w-full max-w-[800px]">
      <h1 class="h1 mb-4 uppercase text-ink">{item.data.title}</h1>

      {/* Plate: caption on the left, catalogue values on the right. */}
      <div
        class="mb-8 flex flex-col gap-2 border-y-2 border-ink py-2 sm:flex-row sm:items-center sm:justify-between"
      >
        <span class="script text-h3 text-ink">{item.data.caption}</span>
        <div class="flex items-center gap-2">
          <span class="tag">{item.data.medium}</span>
          <span class="tag">{item.data.year}</span>
        </div>
      </div>

      <p class="prose mb-8 border-l-2 border-ink pl-4 text-reading">
        {item.data.description}
      </p>

      <div class="copy">
        <Content />
      </div>
    </div>
  </article>
</Layout>
