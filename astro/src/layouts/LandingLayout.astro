---
import { ClientRouter } from "astro:transitions";
import "../styles/tailwind.css";
import ScrollPager from "../components/ScrollPager.astro";
import PageTransition from "../components/PageTransition.astro";
import Meta from "../components/Meta.astro";
import { HOME_TITLE } from "../lib/site";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* The tab icon, in the order browsers pick from: .ico for the ones
        that only take that, the SVG for everything current, then the sizes
        iOS and Android use when the site is saved to a home screen.

        The .ico holds all three squares listed here, and they are listed
        because `sizes` is what a crawler reads instead of opening the file.
        Google wants a 48px square and will pass over an icon that claims to
        be 32 — which is how the site came to be shown in search results
        under a generic framework mark rather than its own. */}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#111111" />
    <meta name="generator" content={Astro.generator} />
    <title>{HOME_TITLE}</title>
    <Meta title={HOME_TITLE} />
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-ink">
    <div id="container" transition:name="landing" transition:animate="none">
      <slot />
    </div>
    <ScrollPager />
    <PageTransition />
  </body>
</html>
