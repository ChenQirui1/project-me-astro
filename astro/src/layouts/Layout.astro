---
import { ClientRouter } from "astro:transitions";
import "../styles/tailwind.css";
import Header from "../components/ui/Header.astro";
import Nav from "../components/ui/Nav.astro";
import ScrollPager from "../components/ScrollPager.astro";

interface Props {
  title?: string;
}

const { title } = Astro.props;
const pageTitle = title ? `${title} / IVAN.C` : "IVAN.C";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <ClientRouter />
  </head>
  <!-- The page is ink; every region below is a paper panel and the 4px gap
       between them is the black sheet showing through. -->
  <body class="flex h-screen flex-col gap-gutter overflow-hidden bg-ink p-gutter">
    <Header />
    <div class="flex flex-1 flex-col gap-gutter overflow-hidden lg:flex-row">
      <Nav activePath={Astro.url.pathname} />
      <main
        id="container"
        class="panel @container/main flex-1 overflow-y-auto"
        transition:animate="none"
      >
        <slot />
      </main>
    </div>
    <ScrollPager />
  </body>
</html>
