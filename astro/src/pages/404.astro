---
import Layout from "../layouts/Layout.astro";

const destinations = [
  { name: "projects", href: "/projects" },
  { name: "gallery", href: "/gallery" },
  { name: "about", href: "/about" },
];
---

<Layout title="404">
  <main class="mx-auto flex min-h-full w-full max-w-[800px] flex-col justify-center p-4 sm:p-8">
    <div class="mb-8">
      <h1 class="h2 inline-block bg-ink px-3 py-2 uppercase text-paper-pure">
        [404] not found
      </h1>
    </div>

    <p class="prose mb-10 border-l-2 border-ink pl-4 text-grey-600">
      That page doesn't exist — it may have moved, or the link may be stale.
    </p>

    <div class="flex w-full border border-ink">
      {
        destinations.map((destination) => (
          <a
            href={destination.href}
            class="label flex-1 border-r border-ink bg-ink px-3 py-3 text-center text-paper-pure transition-[background-color,color] duration-[80ms] ease-linear last:border-r-0 hover:bg-warning hover:text-ink"
          >
            {destination.name}
          </a>
        ))
      }
    </div>

    <div class="hazard mt-gutter h-[6px] border border-ink" aria-hidden="true"></div>

    <div class="pt-8">
      <a href="/" class="btn btn-ghost">← .home</a>
    </div>
  </main>
</Layout>
