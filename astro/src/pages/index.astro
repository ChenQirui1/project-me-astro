---
import Layout from "../layouts/LandingLayout.astro";
import Socials from "../components/Socials.astro";

// Same landing arrangement as before: call to action, the offset nav rows,
// then the name plate. Only the dressing changed.
const rows = [
  { href: "/about", label: "about", lead: "flex-1", trail: "" },
  { href: "/contact", label: "contact", lead: "w-1/3", trail: "flex-1" },
  { href: "/projects", label: "projects", lead: "", trail: "flex-1" },
  { href: "/gallery", label: "gallery", lead: "w-1/4", trail: "flex-1" },
];
---

<Layout>
  <main
    class="mx-auto flex min-h-screen w-full max-w-2xl flex-col gap-gutter p-gutter"
  >
    <section class="flex items-stretch gap-gutter">
      <div class="hazard flex-1 border border-grey-700" aria-hidden="true">
      </div>
      <a href="/contact" class="btn btn-accent">get in touch</a>
    </section>

    <div class="grid-lines min-h-24 flex-1 border border-grey-700 opacity-20">
    </div>

    {/* Offset index rows — the black sheet reads through the empty cells. */}
    <section class="border-y border-grey-700">
      {
        rows.map((row) => (
          <div class="flex border-b border-grey-700 last:border-b-0">
            {row.lead && <div class={`${row.lead} border-r border-grey-700`} />}
            <a
              href={row.href}
              class="label border-r border-grey-700 px-4 py-4 text-paper-pure transition-[background-color,color] duration-[80ms] ease-linear hover:bg-paper hover:text-ink"
            >
              {row.label}
            </a>
            {row.trail && <div class={row.trail} />}
          </div>
        ))
      }
    </section>

    <div class="grid-lines min-h-16 flex-1 border border-grey-700 opacity-20">
    </div>

    {/* Name plate */}
    <section class="border border-grey-700">
      <h1
        class="display border-b border-grey-700 px-4 py-6 text-display text-paper-pure sm:text-display-xl"
      >
        IVAN
      </h1>
      <div
        class="flex flex-col justify-between gap-6 p-4 sm:flex-row sm:items-end"
      >
        <h2 class="h3 uppercase text-paper-pure">
          Interaction <br /> Designer
        </h2>
        <div class="text-paper-pure">
          <Socials />
        </div>
      </div>
    </section>
  </main>
</Layout>
