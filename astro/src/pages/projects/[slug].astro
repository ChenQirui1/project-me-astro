---
import Layout from "../../layouts/Layout.astro";
import Carousel from "../../components/Carousel.astro";
import Lightbox from "../../components/Lightbox.astro";
import { getCollection, render } from "astro:content";
import { asset } from "../../lib/assets";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

// The split "Design | Engineering" tag strip. Confluence-synced projects carry
// a disciplines list; hand-authored ones carry a comma-separated `medium`.
const mediums =
  project.data.disciplines.length > 0
    ? project.data.disciplines
    : project.data.medium
      ? project.data.medium.split(",").map((m) => m.trim())
      : [];

// What kind of project this is, shown above the year. Synced pages rarely fill
// in a project type, so fall back to where the page sits in the Confluence tree.
const kind =
  project.data.projectType ?? project.data.subcategory ?? project.data.category;

const projects = (await getCollection("projects")).sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0),
);
// The hero is the thumbnail shown large at the top of the page. The sync
// lifts it out of the body when it stood alone there, but an image that is
// part of a composition — a column of a comparison, a captioned figure —
// has to stay where the author put it. In that case the body is already
// showing it, so the page withholds the hero rather than printing it twice.
const heroInBody = project.data.thumbnail
  ? project.body?.includes(project.data.thumbnail) === true
  : false;
const hero = heroInBody ? undefined : project.data.thumbnail;

const currentIndex = projects.findIndex((p) => p.id === project.id);
const prevId = projects[(currentIndex - 1 + projects.length) % projects.length].id;
const nextId = projects[(currentIndex + 1) % projects.length].id;
---

<Layout
  title={project.data.title}
  description={project.data.description}
  image={asset(project.data.thumbnail)}
  imageAlt={project.data.title}
  type="article"
>
  <article class="mx-auto w-full max-w-[820px] p-4 sm:p-8">
    {/* Back Link — lands on this project's card in the catalogue */}
    <div class="mb-4">
      <a
        href={`/projects#${project.id}`}
        class="btn btn-ghost min-h-0 px-2 py-1 text-micro"
      >
        ← back to projects
      </a>
    </div>

    {/* Title Block — year over type at the far right, sitting on the title
        plate's baseline. On a phone there isn't room for both beside the
        plate: a type as long as "Digital Products & Systems" was pushed off
        the sheet, so the two become one meta line above the title instead,
        free to wrap. Order, not DOM, moves it — the h1 stays first. */}
    <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between sm:gap-4">
      <h1
        class="h2 order-2 self-start bg-ink px-3 py-2 text-paper-pure uppercase sm:order-1"
      >
        {project.data.title}
      </h1>
      <div
        class="order-1 flex flex-wrap items-baseline gap-x-3 gap-y-1 sm:order-2 sm:min-w-0 sm:flex-col sm:items-end sm:pb-2 sm:text-right"
      >
        <span class="h3 text-ink">{project.data.year}</span>
        {kind && <span class="label text-grey-600">{kind}</span>}
      </div>
    </div>

    {/* Main Image — shown whole, never cropped and never stretched. It sizes
        itself: a wide hero fills the column, and a tall one (several of these
        are phone screenshots) comes down to the 16:9 height cap and stands
        centred with the margin either side, which keeps it above the fold and
        at its own resolution instead of soft.
        The frame is the box, not the image: a narrow hero is letterboxed in a
        full-width plate the way a carousel slide is, rather than wearing a
        hairline of its own out in the middle of the column.
        A dashed skeleton holds the slot when the project has no hero yet. */}
    <div class="@container mb-8">
      {
        hero ? (
          <div class="flex justify-center border border-ink bg-paper" data-lightbox>
            <img
              src={asset(hero)}
              alt={project.data.title}
              class="block max-h-[56.25cqw] w-auto max-w-full"
            />
          </div>
        ) : (
          <div class="grid-lines flex aspect-video w-full items-center justify-center border border-dashed border-ink">
            <span class="micro text-grey-500">no hero media</span>
          </div>
        )
      }

      {/* Medium / Tags — boxed chips captioning the image */}
      {
        mediums.length > 0 && (
          <ul class="mt-3 flex flex-wrap gap-2">
            {mediums.map((m) => (
              <li class="tag">{m}</li>
            ))}
          </ul>
        )
      }
    </div>

    {/* Content Area */}
    <div class="flex flex-col gap-8">
      {/* Description */}
      {
        project.data.description && (
          <p class="prose border-l-2 border-ink pl-4 text-reading">
            {project.data.description}
          </p>
        )
      }

      {/* Body content. Carousel is script only — it binds the image sets the
          Confluence sync collapsed in the Markdown. */}
      <div class="copy">
        <Content />
      </div>
      <Carousel />
      <Lightbox />

      {/* No media grid. Every visual the page uses is already placed in the
          body, in the order the author wrote it; a flat grid of the same
          attachments underneath only repeated them out of context. The
          `gallery` frontmatter is still written by the sync, so nothing is
          lost if it is wanted back. */}


      {/* Prev / Next */}
      <div class="flex justify-between gap-4 border-t border-ink pt-6">
        <a href={`/projects/${prevId}`} class="btn btn-ghost">← prev</a>
        <a href={`/projects/${nextId}`} class="btn btn-ghost">next →</a>
      </div>
    </div>
  </article>
</Layout>
