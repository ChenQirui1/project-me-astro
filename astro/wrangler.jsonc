{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "project-me-astro",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-01",

  // Custom domain. Cloudflare manages the DNS record and certificate for
  // the zone on deploy; the workers.dev URL keeps working alongside it.
  "routes": [{ "pattern": "ivanchen.xyz", "custom_domain": true }],

  // Astro builds a fully static site into `dist/`, served straight from the
  // assets binding. `run_worker_first` scopes the Worker to the one route
  // that isn't a file on disk — the /img/* R2 proxy in worker/index.ts — so
  // every page and script is served without a Worker invocation.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/img/*"]
  },

  // Private bucket. Nothing is publicly reachable on R2 itself — every read
  // goes through worker/index.ts, which is the only thing holding the binding.
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "project-me-assets"
    }
  ],

  "observability": {
    "enabled": true
  }
}
